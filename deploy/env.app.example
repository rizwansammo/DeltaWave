# /opt/DeltaWave/.env.app — root-only (chmod 600). Variable names only; never commit values.

# Database (the stack's own PostgreSQL service "db").
DATABASE_URL=postgresql://deltawave:<password>@db:5432/deltawave
PAYLOAD_SECRET=<at least 32 random characters>
# Encrypts the SMTP password stored in the CMS. 64 hex characters, generated
# once on the server (openssl rand -hex 32). Not in the database or its
# backups; keep a copy in a password manager.
CREDENTIALS_ENCRYPTION_KEY=<64 hex characters>

# Search engines: keep false until the owner approves indexing.
SITE_INDEXABLE=false

# Spam protection for the enquiry form (Cloudflare Turnstile). Without both,
# the form stays closed whatever the CMS setting says.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email is configured in the CMS (Site settings → Email & enquiries), not here.

# Cloudflare R2 media storage. Leave empty to keep the persistent media volume.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
