# DeltaWave Technology environment template.
# Run `pnpm setup:env` to create an untracked .env with generated local secrets.
# Never commit .env or real credentials.

# Local PostgreSQL started by docker-compose.yml (localhost only).
POSTGRES_USER=deltawave
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=deltawave
POSTGRES_PORT=54330

# Payload CMS.
DATABASE_URL=postgresql://deltawave:replace-with-a-long-random-value@127.0.0.1:54330/deltawave
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Public site origin. Use http://localhost:3000 locally and
# https://www.deltawave.tech only for the approved production deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until a public launch is approved.
NEXT_PUBLIC_INDEXABLE=false

# Enquiry delivery. Set only when the email sender and anti-spam
# configuration are ready.
ENQUIRY_EMAIL_API_KEY=
ENQUIRY_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Planned production media storage (Cloudflare R2, Phase 2). Not used yet.
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
