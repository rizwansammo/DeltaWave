# DeltaWave Technology environment template.
# Run `pnpm setup:env` to create an untracked .env with generated local secrets.
# Never commit .env or real credentials.

# Local PostgreSQL started by docker-compose.yml (localhost only).
POSTGRES_USER=deltawave
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=deltawave
POSTGRES_PORT=54330

# Payload CMS.
DATABASE_URL=postgresql://deltawave:replace-with-a-long-random-value@127.0.0.1:54330/deltawave
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
# Optional. Directory for uploaded files on local disk (default: media).
# The end-to-end suite sets it to .qa/test-media.
# MEDIA_DIR=media

# Public site origin, inlined at build time. Use http://localhost:3000 locally;
# the production image is built with https://www.deltawave.tech.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Read at runtime. Keep false until a public launch is approved.
SITE_INDEXABLE=false

# Enquiry form spam protection (Cloudflare Turnstile). Without both keys, and
# without "Accept enquiries online" in Site settings, the form stays closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Outgoing email for password resets and enquiry notifications (SMTP).
# Without SMTP_HOST, SMTP_USER and SMTP_PASS, development prints emails to the
# console and production sends nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=DeltaWave Technology
MAIL_ALLOWED_SENDER_DOMAINS=deltawave.tech

# Optional media storage in Cloudflare R2. Empty: uploads stay in MEDIA_DIR.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
